CREATE VIEW DateTimeLab.v_ArtifactDefinitions
AS
    SELECT o.type_desc AS ArtifactType,
           OBJECT_SCHEMA_NAME(o.object_id) AS SchemaName,
           o.name AS ObjectName, CAST(NULL AS sysname) AS ColumnName,
           m.definition AS ExpressionText
    FROM sys.objects AS o
    JOIN sys.sql_modules AS m ON m.object_id = o.object_id
    WHERE o.schema_id = SCHEMA_ID(N'DateTimeLab')
    UNION ALL
    SELECT o.type_desc, OBJECT_SCHEMA_NAME(o.object_id), o.name,
           COL_NAME(d.parent_object_id, d.parent_column_id), d.definition
    FROM sys.default_constraints AS d
    JOIN sys.objects AS o ON o.object_id = d.object_id
    WHERE o.schema_id = SCHEMA_ID(N'DateTimeLab')
    UNION ALL
    SELECT o.type_desc, OBJECT_SCHEMA_NAME(o.object_id), o.name,
           COL_NAME(c.parent_object_id, c.parent_column_id), c.definition
    FROM sys.check_constraints AS c
    JOIN sys.objects AS o ON o.object_id = c.object_id
    WHERE o.schema_id = SCHEMA_ID(N'DateTimeLab')
    UNION ALL
    SELECT N'COMPUTED_COLUMN', OBJECT_SCHEMA_NAME(c.object_id),
           OBJECT_NAME(c.object_id), c.name, c.definition
    FROM sys.computed_columns AS c
    JOIN sys.objects AS o ON o.object_id = c.object_id
    WHERE o.schema_id = SCHEMA_ID(N'DateTimeLab');
GO

CREATE PROCEDURE DateTimeLab.usp_SmokeTest
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;
    DECLARE @OwnTransaction bit = CASE WHEN @@TRANCOUNT = 0 THEN 1 ELSE 0 END;
    IF @OwnTransaction = 1 BEGIN TRANSACTION;
    ELSE SAVE TRANSACTION DateTimeLabSmoke;

    BEGIN TRY
        DECLARE @Ids TABLE (SampleId int PRIMARY KEY);
        INSERT DateTimeLab.Sample (SampleName, RegionTimeZone)
            OUTPUT inserted.SampleId INTO @Ids
        VALUES (N'__Smoke_One', N'Yukon Standard Time'),
               (N'__Smoke_Two', N'Canada Central Standard Time');

        IF (SELECT COUNT(*) FROM DateTimeLab.Audit AS a JOIN @Ids AS i
            ON i.SampleId = a.SampleId WHERE a.Operation = 'I') <> 2
            THROW 51030, 'Multi-row INSERT audit failed.', 1;

        UPDATE s SET UtcStart = DATEADD(second, 1, UtcStart), Notes = N'Smoke test'
        FROM DateTimeLab.Sample AS s JOIN @Ids AS i ON i.SampleId = s.SampleId;
        IF (SELECT COUNT(*) FROM DateTimeLab.Audit AS a JOIN @Ids AS i
            ON i.SampleId = a.SampleId WHERE a.Operation = 'U' AND a.StartShiftSeconds = 1) <> 2
            THROW 51031, 'Multi-row UPDATE audit failed.', 1;

        IF EXISTS (SELECT 1 FROM DateTimeLab.Sample AS s JOIN @Ids AS i ON i.SampleId = s.SampleId
            WHERE DATEPART(tzoffset, s.DefaultUtcOffset) <> 0
               OR s.MonthEnd <> EOMONTH(s.DateValue)
               OR s.DurationSeconds < 0)
            THROW 51032, 'Default or computed expression failed.', 1;

        DELETE s FROM DateTimeLab.Sample AS s JOIN @Ids AS i ON i.SampleId = s.SampleId;
        IF (SELECT COUNT(*) FROM DateTimeLab.Audit AS a JOIN @Ids AS i
            ON i.SampleId = a.SampleId WHERE a.Operation = 'D') <> 2
            THROW 51033, 'Multi-row DELETE audit failed.', 1;

        DECLARE @Value datetime2(7) = '2026-10-20T12:34:56.1234567';
        DECLARE @Offset datetimeoffset(7) = '2026-10-20T12:34:56.1234567-05:30';
        SELECT * INTO #Expressions
        FROM DateTimeLab.ufn_DateTimeExpressions
            (@Value, @Offset, N'Eastern Standard Time (Mexico)', N'not-a-date');

        IF (SELECT COUNT(*) FROM #Expressions) <> 1
            THROW 51034, 'Inline table-valued function did not return one row.', 1;
        IF EXISTS (SELECT 1 FROM #Expressions
            WHERE ConstructedDateTime2 <> @Value
               OR ConstructedDateTimeOffset <> @Offset
               OR DATEPART(tzoffset, ConstructedDateTimeOffset) <> -330
               OR Bucket15Minutes <> CONVERT(datetime2(7), '2026-10-20T12:30:00', 126)
               OR MonthEnd <> DATEFROMPARTS(2026, 10, 31)
               OR IsLegacyDate <> 1
               OR ParsedCanonicalDate <> DATEFROMPARTS(2026, 10, 20)
               OR TryCastDateTime2 IS NOT NULL
               OR TryConvertOffset IS NOT NULL
               OR TryParsedDateTime2 IS NOT NULL
               OR FormattedText <> N'2026-10-20 12:34:56.1234567'
               OR DATEPART(tzoffset, UtcConvertedToRegion) <> -300
               OR CAST(SWITCHOFFSET(UtcConvertedToRegion, '+00:00') AS datetime2(7)) <> @Value)
            THROW 51035, 'Date/time expression or conversion assertion failed.', 1;

        IF DATEPART(tzoffset, DateTimeLab.ufn_ToRegion(@Value, N'Yukon Standard Time')) <> -420
            THROW 51036, 'Scalar UTC-to-region function failed.', 1;
        IF (SELECT ActualMinutes FROM DateTimeLab.ufn_DayWindows
            (DATEFROMPARTS(2026, 3, 8), 1, N'Pacific Standard Time')) <> 1380
            THROW 51037, 'Spring-forward day must have 23 hours with the installed Pacific rules.', 1;
        IF (SELECT ActualMinutes FROM DateTimeLab.ufn_DayWindows
            (DATEFROMPARTS(2026, 11, 1), 1, N'Pacific Standard Time')) <> 1500
            THROW 51038, 'Fall-back day must have 25 hours with the installed Pacific rules.', 1;

        IF (SELECT COUNT(*) FROM DateTimeLab.v_BuiltinCoverage) <> 56
            THROW 51039, 'The builtin coverage inventory is incomplete.', 1;
        IF EXISTS
        (
            SELECT 1 FROM DateTimeLab.v_BuiltinCoverage
            WHERE OBJECT_ID(PrimaryArtifact) IS NULL
               OR CHARINDEX(BuiltinName, OBJECT_DEFINITION(OBJECT_ID(PrimaryArtifact))) = 0
        )
            THROW 51040, 'A coverage entry is missing from its primary artifact.', 1;

        IF @OwnTransaction = 1 ROLLBACK TRANSACTION;
        ELSE ROLLBACK TRANSACTION DateTimeLabSmoke;
        PRINT 'DateTimeLab smoke tests passed; test rows and their audit rows were rolled back.';
    END TRY
    BEGIN CATCH
        IF @OwnTransaction = 1 AND XACT_STATE() <> 0 ROLLBACK TRANSACTION;
        ELSE IF @OwnTransaction = 0 AND XACT_STATE() = 1 ROLLBACK TRANSACTION DateTimeLabSmoke;
        THROW;
    END CATCH;
END;
GO

